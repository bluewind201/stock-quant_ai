# 이 파일을 같은 폴더에 .env 라는 이름으로 복사해서 값을 채우세요.
# Docker Compose 는 프로젝트 폴더의 .env 만 자동으로 읽습니다. 다른 이름은 읽히지 않습니다.
# 실제 키는 절대 이 예시 파일에 적지 마세요.

# 화면 로그인 비밀번호. 비어 있으면 로그인이 503 으로 실패합니다.
ADMIN_PASSWORD=
# 비워두면 재시작할 때마다 모든 로그인 세션이 끊깁니다.
# 생성:  python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
COOKIE_SECURE=false
# 접속 주소. NAS 나 다른 PC 에서 접속하려면 반드시 0.0.0.0:8430 으로 바꾸세요.
# 127.0.0.1 은 그 기계 안에서만 열립니다.
STOCK_BIND=127.0.0.1:8430
STOCK_IMAGE=bluewind201/stock-quant:latest
PAPER_RESUME_ON_RESTART=false
STOCK_BROKER=toss
# 판단은 Claude 구독으로 합니다. API 키가 아니라 구독 토큰입니다.
#   PC 에서 한 번만:  claude setup-token
#   출력된 sk-ant-oat... 값을 아래에 붙여넣으세요. 유효기간 1년입니다.
#   (3.22.0) 비워 두고 웹 화면 "연결 · 설정 → AI 로그인"에서 로그인하거나 토큰을 붙여넣어도 됩니다.
#   그 방식은 거래 기록 볼륨에 저장되어 이미지를 업데이트해도 다시 로그인할 필요가 없습니다.
CLAUDE_CODE_OAUTH_TOKEN=
# 모델과 사고량. 비워두면 sonnet / low 로 돌아 토큰을 아낍니다.
# 판단 품질을 올리려면 SQT_AI_MODEL=opus, SQT_AI_EFFORT=medium 을 써보세요.
SQT_AI_MODEL=
SQT_AI_EFFORT=
# 하루 판단 호출 횟수 상한 (모의·실거래, 원화·달러 공유. UTC 자정 초기화)
SQT_AI_DAILY_BUDGET=64
# CLI 를 직접 설치한 경우에만: claude 실행 파일 절대 경로
SQT_CLAUDE_EXECUTABLE=
# 실거래 (당일 단타 · 관심종목 운용 공통). 모의로 검증한 뒤에만 켠다.
#   ENABLE_LIVE_TRADING=true  로 바꾸고 컨테이너를 다시 만들어야 실거래 계좌를 만들 수 있다
#   TOSS_ACCOUNT_SEQ          주문을 낼 토스 계좌 식별자. 화면 설정 · 연결 → "토스 계좌 식별자 조회"
#                             단타는 보유 주식이 없는 전용 계좌를 쓴다 (장기 보유분과 섞이지 않게)
#   LIVE_CAPITAL_KRW          실거래 계좌가 쓸 수 있는 돈의 상한 (투입 자금은 이 값 이하)
#   LIVE_MAX_ORDER_KRW        주문 1건 상한. 처음엔 작게
ENABLE_LIVE_TRADING=false
TOSS_ACCOUNT_SEQ=
LIVE_CAPITAL_KRW=1000000
LIVE_CAPITAL_USD=1000
LIVE_MAX_ORDER_KRW=1000000
LIVE_MAX_ORDER_USD=1000
# Toss WTS > Settings > Open API: register client keys and allow the server's public IP.
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
# These select ONLY the KIS market-data environment, never order execution.
# Match the application keys to demo (virtual server) or real (production quotes).
KIS_ENV=demo
KIS_APP_KEY=
KIS_APP_SECRET=
NEWS_AUTO_REFRESH=true

# 텔레그램 알림 (선택). 둘 다 채우면 매수·익절·손절 체결과 결산을 보냅니다.
#   1) 텔레그램에서 @BotFather 에게 /newbot → 토큰 발급
#   2) 만든 봇에게 아무 말이나 보낸 뒤 chat_id 확인:
#      https://api.telegram.org/bot<토큰>/getUpdates  →  "chat":{"id": 숫자}
#   비워두면 알림 없이 정상 동작합니다.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 텔레그램 알림 범위: trades = 매수·익절·손절·결산만(기본), all = 계획·판단·복기·금융 일정 포함.
# 웹 설정 화면에서 바꾸면 그 값이 우선합니다.
TELEGRAM_LEVEL=trades
# 알림에 붙일 웹 화면 주소 (선택). 예: http://192.168.0.10:8430
PUBLIC_URL=
